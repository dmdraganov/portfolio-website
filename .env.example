# Local development needs no environment variables.
#
# For a local production-build rehearsal, copy this file to .env.local, replace
# the sample counter ID, then run: npm run build:release
# Do not set VERCEL_ENV or VERCEL_PROJECT_PRODUCTION_URL in Vercel: those are
# Vercel system environment variables. In Vercel, set YANDEX_METRICA_ID only
# for the Production environment.

SITE_URL=https://draganov.vercel.app
YANDEX_METRICA_ID=12345678
