{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "BUILD_PROFILE=local next dev",
    "build": "npm run validate && next build",
    "build:local": "BUILD_PROFILE=local npm run build",
    "build:test": "BUILD_PROFILE=test npm run build",
    "build:release": "BUILD_PROFILE=release npm run build",
    "start": "next start",
    "format": "prettier --write src tests scripts package.json next.config.ts tsconfig.json eslint.config.mjs postcss.config.mjs",
    "format:check": "prettier --check src tests scripts package.json next.config.ts tsconfig.json eslint.config.mjs postcss.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:media": "node scripts/check-media.ts",
    "images:convert": "node scripts/convert-images.ts",
    "test": "node --test tests/config/build.test.ts tests/content/check-media.test.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:media"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
